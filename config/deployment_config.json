    "loopback_enforced": true,
    "public_binding_allowed": false,
    "wan_egress_policy": "BLOCKED"
  },
  "models": {
    "inference_engine": "OLLAMA",
    "endpoint": "http://localhost:11434",
    "timeout_seconds": 90,
    "roles": {
      "REASONING_MODEL": "qwen2.5:7b",
      "CODING_MODEL": "qwen2.5:7b",
      "VISION_MODEL": "qwen2.5vl:7b",
      "EMBEDDING_MODEL": "all-MiniLM-L6-v2"
    },
    "cloud_fallback": false
  },
  "storage_paths": {
    "chroma_db": "chroma_db",
    "chroma_sqlite_file": "chroma_db/chroma.sqlite3",
    "chroma_collection": "industrial_documents",
    "knowledge_base": "knowledge_base",
    "data_sample": "data",
    "output_deliverables": "output",
    "sandbox_workspace": "workspace/output",
    "frontend_assets": "frontend"
  },
  "deliverables": {
    "supported_formats": ["DOCX", "XLSX", "PPTX", "TXT", "CSV", "PY"],
    "retention_policy": "PERSISTENT_LOCAL_DISK",
    "verification_engine": "AST_AND_OPENXML_ASSERTIONS"
