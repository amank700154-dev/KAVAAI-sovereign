{
  "system": {
    "name": "KAVAAI SOVEREIGN",
    "problem_statement": "SIH26117",
    "product_category": "Sovereign On-Premise Agentic AI Workbench",
    "version": "1.0.0",
    "security_profile": "AIR_GAPPED_LOCAL_ONLY"
  },
  "networking": {
    "application_host": "127.0.0.1",
