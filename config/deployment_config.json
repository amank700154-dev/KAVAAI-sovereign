  "hardware": {
    "gpu_acceleration": "CUDA",
    "tested_gpu": "NVIDIA GeForce RTX 3050 6GB Laptop GPU",
    "cuda_version": "12.1",
    "fallback_mode": "CPU_INFERENCE",
    "minimum_ram_gb": 16,
    "minimum_disk_free_gb": 12
