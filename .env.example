# ==============================================================================
# KAVAAI SOVEREIGN — INDUSTRIAL DEPLOYMENT CONFIGURATION TEMPLATE
# SIH26117: Sovereign On-Premise Agentic AI Workbench for Confidential Work
# Copy this file to .env: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Host interface binding (Must remain 127.0.0.1 for strict air-gap compliance)
HOST=127.0.0.1
# HTTP port for the KAVAAI workbench
PORT=8000
# Debug mode (Always keep false for production and demonstration environments)
DEBUG=false

# ------------------------------------------------------------------------------
# 2. LOCAL AI OLLAMA CONFIGURATION (ZERO EXTERNAL / CLOUD CALLS)
# ------------------------------------------------------------------------------
# Ollama daemon endpoint (Must remain on local loopback)
OLLAMA_HOST=http://localhost:11434
# Request timeout in seconds for multi-step agent reasoning
OLLAMA_TIMEOUT=90

# Model Role Assignments (Must be open-weight models installed in local Ollama)
KAVAAI_REASONING_MODEL=qwen2.5:7b
KAVAAI_CODING_MODEL=qwen2.5:7b
KAVAAI_VISION_MODEL=qwen2.5vl:7b
KAVAAI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 3. AIR-GAP GOVERNANCE & NETWORK ISOLATION
# ------------------------------------------------------------------------------
# Set to true to enforce socket-level interception and blocking of all external WAN calls
AIR_GAP_STRICT_MODE=true

# ------------------------------------------------------------------------------
# 4. STORAGE & RAG PATH OVERRIDES (OPTIONAL - DEFAULTS TO REPO PATHS)
# ------------------------------------------------------------------------------
# Relative or absolute path to persistent ChromaDB vector store
KAVAAI_CHROMA_PATH=chroma_db
# Directory where generated forensic reports and deliverables are stored
KAVAAI_OUTPUT_DIR=output
# Source document vault directory for technical manuals, SOPs, and inspection reports
KAVAAI_KNOWLEDGE_BASE_PATH=knowledge_base

# ------------------------------------------------------------------------------
# 5. FRONTEND AUTHENTICATION (OPTIONAL - AIR-GAP LOCAL NODE ACTIVE BY DEFAULT)
# ------------------------------------------------------------------------------
# Leave blank to run in 100% offline Local Node mode (one-click operator access).
# If connecting to an on-premise Supabase instance, supply public anon keys only.
# NEVER expose SERVICE_ROLE_KEY to frontend code!
SUPABASE_URL=
SUPABASE_ANON_KEY=
