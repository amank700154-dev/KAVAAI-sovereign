# ==============================================================================
# KAVAAI SOVEREIGN — INDUSTRIAL DEPLOYMENT CONFIGURATION TEMPLATE
# SIH26117: Sovereign On-Premise Agentic AI Workbench for Confidential Work
# Copy this file to .env: cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# ==============================================================================
# LAYER 1: PUBLIC CLOUD APPLICATION (VERCEL + RENDER + SUPABASE)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT (Configured on Vercel Dashboard)
# ------------------------------------------------------------------------------
# URL of the deployed Render backend (e.g., https://kavaai-backend.onrender.com)
VITE_API_BASE_URL=https://kavaai-backend.onrender.com

# Supabase Public Anonymous Configuration for Browser Auth
# (Get these from: Supabase Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER CONFIGURATION (Configured on Render Dashboard)
# ------------------------------------------------------------------------------
# Binding host:
# - Local Workstation: 127.0.0.1
# - Render / Docker Cloud: 0.0.0.0
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Deployment Mode:
# - CLOUD_PUBLIC: Public cloud backend (Vercel/Render/Supabase)
# - LOCAL_SOVEREIGN: Local confidential AI node (RTX 3050 + Local Ollama)
KAVAAI_DEPLOYMENT_MODE=LOCAL_SOVEREIGN

# Allowed CORS Origins (Include Vercel frontend URL, e.g. https://kavaai-sovereign.vercel.app)
CORS_ORIGINS=http://127.0.0.1:8000 http://localhost:8000 http://localhost:5173 https://your-kavaai-frontend.vercel.app

# Backend Supabase Configuration (Public Anon Key ONLY - NEVER put service_role_key here!)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-public-anon-key

# ==============================================================================
# LAYER 2: LOCAL SOVEREIGN AI LAYER (WINDOWS + NVIDIA RTX 3050 + OLLAMA)
# ==============================================================================

# ------------------------------------------------------------------------------
# 3. LOCAL OLLAMA INFERENCE (ZERO EXTERNAL WAN CALLS)
# ------------------------------------------------------------------------------
# Ollama daemon endpoint:
# - Native Windows execution: http://localhost:11434
# - Docker container execution: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=90

# Model Assignments (Must be open-weight models pulled in local Ollama)
OLLAMA_MODEL=qwen2.5:7b
KAVAAI_REASONING_MODEL=qwen2.5:7b
KAVAAI_CODING_MODEL=qwen2.5:7b
KAVAAI_VISION_MODEL=qwen2.5vl:7b
KAVAAI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ------------------------------------------------------------------------------
# 4. AIR-GAP GOVERNANCE & NETWORK ISOLATION (LOCAL SOVEREIGN MODE)
# ------------------------------------------------------------------------------
# Set to true on local nodes to enforce socket-level interception and blocking of external WAN calls
# (Set to false on Render public server)
AIR_GAP_STRICT_MODE=true

# ------------------------------------------------------------------------------
# 5. STORAGE & LOCAL RAG PATH OVERRIDES
# ------------------------------------------------------------------------------
KAVAAI_CHROMA_PATH=chroma_db
KAVAAI_OUTPUT_DIR=output
KAVAAI_KNOWLEDGE_BASE_PATH=knowledge_base
