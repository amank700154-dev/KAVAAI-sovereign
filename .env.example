# Local AI Ollama Endpoint (Must remain 100% loopback / on-premise)
OLLAMA_HOST=http://localhost:11434
OLLAMA_TIMEOUT=90

# Model Role Assignments (Local Ollama Models Only)
KAVAAI_REASONING_MODEL=qwen2.5:7b
KAVAAI_CODING_MODEL=qwen2.5:7b
KAVAAI_VISION_MODEL=qwen2.5vl:7b
KAVAAI_EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server Configuration
PORT=8000
HOST=127.0.0.1

# Air-Gap Governance (True enforces loopback only, blocking external WAN sockets)
AIR_GAP_STRICT_MODE=true
